    - m_SelectorType: 1
      m_ViewType:
        m_TypeName: 
      m_OpenAndFocus: 0
      m_EditorWindowType:
        m_TypeName: UnityEditor.InspectorWindow, UnityEditor, Version=0.0.0.0, Culture=neutral, PublicKeyToken=null
      m_AlternateEditorWindowTypes:
        m_Items: []
      m_MaskType: 0
      m_MaskSizeModifier: 0
      m_UnmaskedControls: []
    MaskPreset: {fileID: 0}
  Text:
    m_Untranslated: "First, let's try the game using <b>Play Mode</b>! You can select Play in the <b>Toolbar</b> at the top of this layout.\n\nGo deeper:\n\n\u2022 The <b>Scene view</b> (in the center of this layout) is where you\u2019ll manipulate and change things.\n\n\u2022 When you enter Play Mode, the Scene view changes into the <b>Game view</b> for testing."
--- !u!114 &-5273984589247445659
MonoBehaviour:
  m_ObjectHideFlags: 1
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 935228c0fd2628c4db5028980babef0b, type: 3}
  m_Name: NarrativeParagraph
  m_EditorClassIdentifier: Unity.Tutorials.Editor::Unity.Tutorials.Editor.Paragraphs.NarrativeParagraph
  m_MaskingSettings:
    m_MaskingEnabled: 0
    m_UnmaskedViews: []
    MaskPreset: {fileID: 0}
  Text:
    m_Untranslated: "The <b>Gravity Down Force</b> property controls how high the player can jump.\n\nGo deeper:\n\n\u2022 When you select a GameObject in the Hierarchy, you\u2019ll see its <b>components</b> in the <b>Inspector</b>. \n\n\u2022 Components contain <b>properties</b> that give a GameObject specific functionalities.\n\n\u2022 The <b>Player Character Controller</b> properties are what make the player character move in response to player input."
